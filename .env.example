# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Separate database used by the /users CRUD
USER_CRUD_DB_DRIVER=mysql
USER_CRUD_DB_HOST=localhost
USER_CRUD_DB_PORT=3306
USER_CRUD_DB_USERNAME=root
USER_CRUD_DB_PASSWORD=
USER_CRUD_DB_NAME=user_crud

# Aiven MySQL connection used by the Product CRUD
# Keep the actual password only in your local .env file.
AIVEN_DB_HOST=
AIVEN_DB_PORT=
AIVEN_DB_USERNAME=lavalust_user
AIVEN_DB_PASSWORD=
AIVEN_DB_NAME=productdb
# Leave blank when using certs/aiven-ca.pem in this project.
AIVEN_DB_SSL_CA=
